# SARA Environment Configuration Example
# Copy to .env and adjust as necessary for your local environment

# ESA SNAP gpt executable path
SNAP_GPT_PATH=C:\Program Files\esa-snap\bin\gpt.exe

# Maximum disk storage budget for satellite product planning (in GB)
STORAGE_BUDGET_GB=10.0

# Default DEM for Range Doppler Terrain Correction
DEFAULT_DEM_NAME=Copernicus 30m Global DEM

# Default Coordinate Reference System
DEFAULT_CRS=EPSG:4326

# Copernicus Data Space Ecosystem (CDSE) Credentials (Optional until download)
# Set either username + password OR a pre-generated access token:
# CDSE_USERNAME=your_copernicus_email@example.com
# CDSE_PASSWORD=your_copernicus_password
# CDSE_ACCESS_TOKEN=

